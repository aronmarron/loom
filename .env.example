# Loom configuration template.
# Copy this file to `.env` and fill in your own values:  cp .env.example .env

# Get a key at https://openrouter.ai/keys  (required only for cloud models)
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1

# Local Ollama server (default works if Ollama runs on this machine)
OLLAMA_BASE=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Optional: spread batch work (PDF embedding) across multiple Ollama hosts.
# Comma-separated. Offline hosts are skipped automatically. Falls back to
# OLLAMA_BASE if unset.
#   OLLAMA_HOSTS=http://localhost:11434,http://192.168.1.50:11434
OLLAMA_HOSTS=http://localhost:11434

# Local SDXL image server — set to the host running sdxl_server.py
SDXL_BASE=http://localhost:5050/

# Storage & memory
LOOM_VECTOR_STORE=./loom_vectors.pkl
MEMORY_WINDOW=6
